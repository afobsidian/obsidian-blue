#!/usr/bin/env bash

set -euo pipefail

export OMARCHY_PATH=/usr/share/omarchy
export XDG_CONFIG_DIRS="$OMARCHY_PATH/config:${XDG_CONFIG_DIRS:-/etc/xdg}"
export LUA_PATH="$OMARCHY_PATH/config/?.lua;${LUA_PATH:-;}"

/usr/libexec/obsidian-blue/quattro-migrate

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
[[ -f "$config" ]] || config="$OMARCHY_PATH/config/hypr/hyprland.lua"
exec uwsm start -g -1 -e -D Hyprland -- start-hyprland -- --config "$config"
