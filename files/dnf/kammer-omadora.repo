[copr:copr.fedorainfracloud.org:kammer:omadora]
name=Omarchy components for Fedora
baseurl=https://download.copr.fedorainfracloud.org/results/kammer/omadora/fedora-$releasever-$basearch/
type=rpm-md
gpgcheck=1
skip_if_unavailable=0
gpgkey=https://download.copr.fedorainfracloud.org/results/kammer/omadora/pubkey.gpg
includepkgs=disktree-bin,gliff,hype,monologue,omasnap,owe,owe-lockfeed,signed
enabled=1
