--- a/bin/omarchy-launch-browser
+++ b/bin/omarchy-launch-browser
@@ -5,24 +5,50 @@
 default_browser=$(env -u BROWSER xdg-settings get default-web-browser)
 if [[ -z $default_browser ]]; then
   default_browser=$(xdg-mime query default x-scheme-handler/https)
 fi
-browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
 
-if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
-  private_flag="--private-window"
-elif [[ $browser_exec =~ edge ]]; then
-  private_flag="--inprivate"
-else
-  private_flag="--incognito"
-fi
+data_dirs=("${XDG_DATA_HOME:-$HOME/.local/share}")
+IFS=: read -r -a xdg_data_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
+data_dirs+=("${xdg_data_dirs[@]}")
+
+desktop_file=""
+for data_dir in "${data_dirs[@]}"; do
+  candidate="$data_dir/applications/$default_browser"
+  if [[ -f $candidate ]]; then
+    desktop_file="$candidate"
+    break
+  fi
+done
+
+[[ -n $desktop_file ]] || {
+  echo "Default browser desktop entry not found: $default_browser" >&2
+  exit 1
+}
+
+url=""
+private=false
+for argument in "$@"; do
+  case "$argument" in
+  --private) private=true ;;
+  *) [[ -z $url ]] && url="$argument" ;;
+  esac
+done
+
+if "$private"; then
+  private_exec=$(awk '
+    /^\[Desktop Action (new-private-window|new-incognito-window)\]$/ { action = 1; next }
+    /^\[/ { action = 0 }
+    action && /^Exec=/ { sub(/^Exec=/, ""); print; exit }
+  ' "$desktop_file")
+  [[ -n $private_exec ]] || {
+    echo "Default browser has no private-window action: $default_browser" >&2
+    exit 1
+  }
+  read -r -a command <<< "$private_exec"
+  launch=()
+  for argument in "${command[@]}"; do
+    case "$argument" in
+    %f|%F|%u|%U|@@|@@u|@@U) ;;
+    *) launch+=("$argument") ;;
+    esac
+  done
+  [[ -n $url ]] && launch+=("$url")
+else
+  launch=(gtk-launch "${default_browser%.desktop}")
+  [[ -n $url ]] && launch+=("$url")
+fi
 
 systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
   --property=StandardOutput=null --property=StandardError=null \
-  uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"
-
-url=""
-for argument in "$@"; do
-  if [[ $argument != "--private" ]]; then
-    url=$argument
-    break
-  fi
-done
-
-if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
-  omarchy-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
-fi
+  uwsm-app -- "${launch[@]}"
